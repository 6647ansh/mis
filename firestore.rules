        isSuperAdmin() ||
        isCeo() ||
        isSales() ||
        // Stores action: manufacturing stage, heatNo, and delay updates only
        (isStores() && incoming().diff(existing()).affectedKeys().hasOnly([
          'currentStage', 'overallStatus', 'delayDays', 'delayReason', 'heatNo', 'stages', 'updatedAt'
        ])) ||
        // Quality action: quality stage & MTC updates only
        (isQuality() && incoming().diff(existing()).affectedKeys().hasOnly([
          'currentStage', 'overallStatus', 'mtcStatus', 'stages', 'updatedAt'
        ])) ||
        // Dispatch action: dispatch stage & status updates only
        (isDispatch() && incoming().diff(existing()).affectedKeys().hasOnly([
          'currentStage', 'overallStatus', 'dispatchStatus', 'stages', 'updatedAt'
        ])) ||
        // Finance action: invoicing & payment status updates only
        (isFinance() && incoming().diff(existing()).affectedKeys().hasOnly([
          'currentStage', 'overallStatus', 'invoiceNo', 'paymentStatus', 'stages', 'updatedAt'
        ]))
      );
      allow delete: if isActiveUser() && isValidId(orderId) && (isSuperAdmin() || isCeo());
