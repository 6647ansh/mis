      );
      allow list: if isActiveUser() && (
        isSuperAdmin() || isCeo() || isFinance() || isSales()
      ) && existing().id is string;
      allow create: if isActiveUser() && isValidId(followUpId) && isValidPaymentFollowUp(incoming(), followUpId) && (
        isSuperAdmin() || isCeo() || isFinance() || isSales()
      );
      allow update: if isActiveUser() && isValidId(followUpId) && isValidPaymentFollowUp(incoming(), followUpId) &&
        incoming().id == existing().id && incoming().invoiceId == existing().invoiceId &&
        incoming().createdAt == existing().createdAt && (
        isSuperAdmin() || isCeo() || isFinance() || isSales()
      );
      allow delete: if isActiveUser() && isValidId(followUpId) && (isSuperAdmin() || isCeo());
    }
  }
}
