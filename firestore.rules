      (!('powerFactor' in data) || (data.powerFactor is number && data.powerFactor >= 0 && data.powerFactor <= 1)) &&
      (!('peakDemandKva' in data) || (data.peakDemandKva is number && data.peakDemandKva >= 0)) &&
      (!('loggedBy' in data) || (data.loggedBy is string && data.loggedBy.size() <= 120)) &&
      data.createdAt is string && data.createdAt.size() >= 4 && data.createdAt.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      isValidDataOrigin(data);
    }

    // 2.21 DimensionalInspectionReport (/dimensionalReports/{reportId})
    function isValidDimensionalReport(data, reportId) {
      return data.keys().hasAll([
        'id', 'reportNo', 'orderId', 'outerDiaNominalMm', 'outerDiaObservedMm',
        'toleranceResult', 'inspectedAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'reportNo', 'orderId', 'batchId', 'drawingNo',
        'outerDiaNominalMm', 'outerDiaObservedMm', 'innerDiaNominalMm',
        'innerDiaObservedMm', 'heightNominalMm', 'heightObservedMm',
        'deviationMm', 'toleranceResult', 'inspectorName', 'inspectedAt',
        'updatedAt', 'dataOrigin'
      ]) &&
      data.id is string && data.id == reportId && data.id.size() >= 1 && data.id.size() <= 128 &&
      data.reportNo is string && data.reportNo.size() >= 2 && data.reportNo.size() <= 64 &&
      isValidId(data.orderId) &&
      (!('batchId' in data) || (data.batchId is string && data.batchId.size() <= 80)) &&
      (!('drawingNo' in data) || (data.drawingNo is string && data.drawingNo.size() <= 80)) &&
      data.outerDiaNominalMm is number && data.outerDiaNominalMm > 0 &&
      data.outerDiaObservedMm is number && data.outerDiaObservedMm > 0 &&
      (!('innerDiaNominalMm' in data) || (data.innerDiaNominalMm is number && data.innerDiaNominalMm >= 0)) &&
      (!('innerDiaObservedMm' in data) || (data.innerDiaObservedMm is number && data.innerDiaObservedMm >= 0)) &&
      (!('heightNominalMm' in data) || (data.heightNominalMm is number && data.heightNominalMm >= 0)) &&
      (!('heightObservedMm' in data) || (data.heightObservedMm is number && data.heightObservedMm >= 0)) &&
      (!('deviationMm' in data) || data.deviationMm is number) &&
      data.toleranceResult is string && data.toleranceResult in ['Within Tolerance', 'Minor Deviation', 'Out of Tolerance'] &&
      (!('inspectorName' in data) || (data.inspectorName is string && data.inspectorName.size() <= 120)) &&
      data.inspectedAt is string && data.inspectedAt.size() >= 4 && data.inspectedAt.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      isValidDataOrigin(data);
    }

    // 2.22 JobCostSheet (/jobCostSheets/{costSheetId})
    function isValidJobCostSheet(data, costSheetId) {
      return data.keys().hasAll([
        'id', 'orderId', 'customerName', 'rawMaterialCostINR',
        'forgingConversionCostINR', 'totalActualCostINR', 'salesRealizationINR',
        'grossMarginPct', 'costStatus', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'orderId', 'customerName', 'productName', 'rawMaterialCostINR',
        'forgingConversionCostINR', 'heatTreatmentCostINR', 'machiningCostINR',
        'testingAndMtcCostINR', 'totalActualCostINR', 'salesRealizationINR',
        'grossMarginINR', 'grossMarginPct', 'costStatus', 'updatedBy',
        'updatedAt', 'dataOrigin'
      ]) &&
      data.id is string && data.id == costSheetId && data.id.size() >= 1 && data.id.size() <= 128 &&
      isValidId(data.orderId) &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 160 &&
      (!('productName' in data) || (data.productName is string && data.productName.size() <= 160)) &&
      data.rawMaterialCostINR is number && data.rawMaterialCostINR >= 0 &&
      data.forgingConversionCostINR is number && data.forgingConversionCostINR >= 0 &&
      (!('heatTreatmentCostINR' in data) || (data.heatTreatmentCostINR is number && data.heatTreatmentCostINR >= 0)) &&
      (!('machiningCostINR' in data) || (data.machiningCostINR is number && data.machiningCostINR >= 0)) &&
      (!('testingAndMtcCostINR' in data) || (data.testingAndMtcCostINR is number && data.testingAndMtcCostINR >= 0)) &&
      data.totalActualCostINR is number && data.totalActualCostINR >= 0 &&
      data.salesRealizationINR is number && data.salesRealizationINR >= 0 &&
      (!('grossMarginINR' in data) || data.grossMarginINR is number) &&
      data.grossMarginPct is number &&
      data.costStatus is string && data.costStatus in ['Draft', 'Provisional', 'Finalized'] &&
      (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      isValidDataOrigin(data);
    }

    // 2.23 TaskRecord (/tasks/{taskId})
    function isValidTaskRecord(data, taskId) {
      return data.keys().hasAll([
        'id', 'taskNo', 'title', 'department', 'assignedRole', 'assignedToUid',
        'assignedToName', 'priority', 'status', 'dueDate', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'taskNo', 'title', 'description', 'department', 'assignedRole',
        'assignedToUid', 'assignedToName', 'assignedByUid', 'assignedByName',
        'orderId', 'customerName', 'priority', 'status', 'dueDate', 'slaHours',
        'submittedAt', 'submissionRemarks', 'verifiedByUid', 'verifiedByName',
        'verifiedAt', 'verificationRemarks', 'rejectionReason', 'escalationLevel',
        'escalatedAt', 'isSopDailyDuty', 'sopClauseRef', 'createdAt', 'updatedAt', 'dataOrigin'
      ]) &&
      data.id is string && data.id == taskId && data.id.size() >= 1 && data.id.size() <= 128 &&
      data.taskNo is string && data.taskNo.size() >= 2 && data.taskNo.size() <= 64 &&
      data.title is string && data.title.size() >= 3 && data.title.size() <= 240 &&
      (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
      data.department is string && data.department.size() >= 2 && data.department.size() <= 80 &&
      isValidRoleValue(data.assignedRole) &&
      data.assignedToUid is string && data.assignedToUid.size() >= 1 && data.assignedToUid.size() <= 128 &&
      data.assignedToName is string && data.assignedToName.size() >= 2 && data.assignedToName.size() <= 160 &&
      (!('assignedByUid' in data) || (data.assignedByUid is string && data.assignedByUid.size() <= 128)) &&
      (!('assignedByName' in data) || (data.assignedByName is string && data.assignedByName.size() <= 160)) &&
      (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 128)) &&
      (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 160)) &&
      data.priority is string && data.priority in ['Critical', 'High', 'Medium', 'Low'] &&
      data.status is string && data.status in [
        'Pending', 'In Progress', 'Submitted for Verification',
        'Verified & Approved', 'Rejected / Rework', 'Escalated'
      ] &&
      data.dueDate is string && data.dueDate.size() >= 4 && data.dueDate.size() <= 40 &&
      (!('slaHours' in data) || (data.slaHours is number && data.slaHours >= 0)) &&
      (!('submittedAt' in data) || (data.submittedAt is string && data.submittedAt.size() <= 40)) &&
      (!('submissionRemarks' in data) || (data.submissionRemarks is string && data.submissionRemarks.size() <= 600)) &&
      (!('verifiedByUid' in data) || (data.verifiedByUid is string && data.verifiedByUid.size() <= 128)) &&
      (!('verifiedByName' in data) || (data.verifiedByName is string && data.verifiedByName.size() <= 160)) &&
      (!('verifiedAt' in data) || (data.verifiedAt is string && data.verifiedAt.size() <= 40)) &&
      (!('verificationRemarks' in data) || (data.verificationRemarks is string && data.verificationRemarks.size() <= 600)) &&
      (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 600)) &&
      (!('escalationLevel' in data) || (data.escalationLevel is string && data.escalationLevel in ['None', 'L1_DeptHead', 'L2_CEO'])) &&
      (!('escalatedAt' in data) || (data.escalatedAt is string && data.escalatedAt.size() <= 40)) &&
      (!('isSopDailyDuty' in data) || data.isSopDailyDuty is bool) &&
      (!('sopClauseRef' in data) || (data.sopClauseRef is string && data.sopClauseRef.size() <= 80)) &&
      data.createdAt is string && data.createdAt.size() >= 4 && data.createdAt.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      isValidDataOrigin(data);
    }

    // 2.24 HandoverRecord (/handovers/{handoverId})
    function isValidHandoverRecord(data, handoverId) {
      return data.keys().hasAll([
        'id', 'handoverCode', 'orderId', 'customerName', 'productName',
        'fromDepartment', 'fromRole', 'fromUid', 'fromUserName',
        'toDepartment', 'toRole', 'status', 'initiatedAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'handoverCode', 'orderId', 'customerName', 'productName',
        'fromDepartment', 'fromRole', 'fromUid', 'fromUserName',
        'toDepartment', 'toRole', 'toUid', 'toUserName', 'quantityMT',
        'heatNo', 'checklistSummary', 'status', 'initiatedAt', 'respondedAt',
        'remarks', 'rejectionReason', 'slaDeadline', 'updatedAt', 'dataOrigin'
      ]) &&
      data.id is string && data.id == handoverId && data.id.size() >= 1 && data.id.size() <= 128 &&
      data.handoverCode is string && data.handoverCode in ['H-1', 'H-2', 'H-3', 'H-4', 'H-5'] &&
      isValidId(data.orderId) &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 160 &&
      data.productName is string && data.productName.size() >= 2 && data.productName.size() <= 160 &&
      data.fromDepartment is string && data.fromDepartment.size() >= 2 && data.fromDepartment.size() <= 80 &&
      isValidRoleValue(data.fromRole) &&
      data.fromUid is string && data.fromUid.size() >= 1 && data.fromUid.size() <= 128 &&
      data.fromUserName is string && data.fromUserName.size() >= 2 && data.fromUserName.size() <= 160 &&
      data.toDepartment is string && data.toDepartment.size() >= 2 && data.toDepartment.size() <= 80 &&
      isValidRoleValue(data.toRole) &&
      (!('toUid' in data) || (data.toUid is string && data.toUid.size() <= 128)) &&
      (!('toUserName' in data) || (data.toUserName is string && data.toUserName.size() <= 160)) &&
      (!('quantityMT' in data) || (data.quantityMT is number && data.quantityMT >= 0)) &&
      (!('heatNo' in data) || (data.heatNo is string && data.heatNo.size() <= 64)) &&
      (!('checklistSummary' in data) || (data.checklistSummary is string && data.checklistSummary.size() <= 600)) &&
      data.status is string && data.status in ['Pending Acceptance', 'Accepted', 'Rejected', 'Escalated'] &&
      data.initiatedAt is string && data.initiatedAt.size() >= 4 && data.initiatedAt.size() <= 40 &&
      (!('respondedAt' in data) || (data.respondedAt is string && data.respondedAt.size() <= 40)) &&
      (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 600)) &&
      (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 600)) &&
      (!('slaDeadline' in data) || (data.slaDeadline is string && data.slaDeadline.size() <= 40)) &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      isValidDataOrigin(data);
    }

    // 2.25 PurchaseRequisitionRecord (/purchaseRequisitions/{requisitionId})
    function isValidPurchaseRequisition(data, requisitionId) {
      return data.keys().hasAll([
        'id', 'prNumber', 'steelGrade', 'requiredMT', 'requiredByDate',
        'requestedByUid', 'requestedByName', 'requestedByRole',
        'priority', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'prNumber', 'orderId', 'steelGrade', 'requiredMT',
        'estimatedCostINR', 'requiredByDate', 'requestedByUid',
        'requestedByName', 'requestedByRole', 'justification', 'priority',
        'status', 'approvedByUid', 'approvedByName', 'approvedAt',
        'rejectionReason', 'convertedPoNumber', 'createdAt', 'updatedAt', 'dataOrigin'
      ]) &&
      data.id is string && data.id == requisitionId && data.id.size() >= 1 && data.id.size() <= 128 &&
      data.prNumber is string && data.prNumber.size() >= 2 && data.prNumber.size() <= 64 &&
      (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 128)) &&
      data.steelGrade is string && data.steelGrade.size() >= 1 && data.steelGrade.size() <= 64 &&
      data.requiredMT is number && data.requiredMT > 0 &&
      (!('estimatedCostINR' in data) || (data.estimatedCostINR is number && data.estimatedCostINR >= 0)) &&
      data.requiredByDate is string && data.requiredByDate.size() >= 4 && data.requiredByDate.size() <= 40 &&
      data.requestedByUid is string && data.requestedByUid.size() >= 1 && data.requestedByUid.size() <= 128 &&
      data.requestedByName is string && data.requestedByName.size() >= 2 && data.requestedByName.size() <= 160 &&
      isValidRoleValue(data.requestedByRole) &&
      (!('justification' in data) || (data.justification is string && data.justification.size() <= 600)) &&
      data.priority is string && data.priority in ['Urgent', 'High', 'Normal'] &&
      data.status is string && data.status in ['Draft', 'Pending Approval', 'Approved', 'Rejected', 'Converted to PO'] &&
      (!('approvedByUid' in data) || (data.approvedByUid is string && data.approvedByUid.size() <= 128)) &&
      (!('approvedByName' in data) || (data.approvedByName is string && data.approvedByName.size() <= 160)) &&
      (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 40)) &&
      (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 600)) &&
      (!('convertedPoNumber' in data) || (data.convertedPoNumber is string && data.convertedPoNumber.size() <= 64)) &&
      data.createdAt is string && data.createdAt.size() >= 4 && data.createdAt.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      isValidDataOrigin(data);
    }

    // 2.26 NcrCapaRecord (/ncrCapaRecords/{ncrId})
    function isValidNcrCapaRecord(data, ncrId) {
      return data.keys().hasAll([
        'id', 'ncrNumber', 'orderId', 'batchId', 'defectCategory',
        'defectDescription', 'affectedQtyMT', 'disposition', 'status',
        'raisedByUid', 'raisedByName', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ncrNumber', 'orderId', 'batchId', 'productName', 'steelGrade',
        'heatNo', 'defectCategory', 'defectDescription', 'affectedQtyMT',
        'rootCause', 'correctiveAction', 'preventiveAction', 'disposition',
        'status', 'raisedByUid', 'raisedByName', 'verifiedByName', 'closedAt',
        'createdAt', 'updatedAt', 'dataOrigin'
      ]) &&
      data.id is string && data.id == ncrId && data.id.size() >= 1 && data.id.size() <= 128 &&
      data.ncrNumber is string && data.ncrNumber.size() >= 2 && data.ncrNumber.size() <= 64 &&
      isValidId(data.orderId) &&
      data.batchId is string && data.batchId.size() >= 1 && data.batchId.size() <= 80 &&
      (!('productName' in data) || (data.productName is string && data.productName.size() <= 160)) &&
      (!('steelGrade' in data) || (data.steelGrade is string && data.steelGrade.size() <= 64)) &&
      (!('heatNo' in data) || (data.heatNo is string && data.heatNo.size() <= 64)) &&
      data.defectCategory is string && data.defectCategory in ['Dimensional', 'Surface Crack', 'UT Indication', 'Hardness Deviation', 'Chemistry Mix', 'Machining Error'] &&
      data.defectDescription is string && data.defectDescription.size() >= 3 && data.defectDescription.size() <= 600 &&
      data.affectedQtyMT is number && data.affectedQtyMT > 0 &&
      (!('rootCause' in data) || (data.rootCause is string && data.rootCause.size() <= 600)) &&
      (!('correctiveAction' in data) || (data.correctiveAction is string && data.correctiveAction.size() <= 600)) &&
      (!('preventiveAction' in data) || (data.preventiveAction is string && data.preventiveAction.size() <= 600)) &&
      data.disposition is string && data.disposition in ['Rework', 'Scrap', 'Use As Is (Concession)', 'Hold'] &&
      data.status is string && data.status in ['Open', 'Root Cause Analysis', 'CAPA Implemented', 'Verified & Closed'] &&
      data.raisedByUid is string && data.raisedByUid.size() >= 1 && data.raisedByUid.size() <= 128 &&
      data.raisedByName is string && data.raisedByName.size() >= 2 && data.raisedByName.size() <= 160 &&
      (!('verifiedByName' in data) || (data.verifiedByName is string && data.verifiedByName.size() <= 160)) &&
      (!('closedAt' in data) || (data.closedAt is string && data.closedAt.size() <= 40)) &&
      data.createdAt is string && data.createdAt.size() >= 4 && data.createdAt.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      isValidDataOrigin(data);
    }

    // 2.27 PaymentFollowUpRecord (/paymentFollowUps/{followUpId})
    function isValidPaymentFollowUp(data, followUpId) {
      return data.keys().hasAll([
        'id', 'invoiceId', 'customerName', 'contactPerson', 'followUpDate',
        'nextFollowUpDate', 'followUpMode', 'outcome', 'loggedByUid',
        'loggedByName', 'loggedByRole', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'invoiceId', 'orderId', 'customerId', 'customerName',
        'contactPerson', 'followUpDate', 'nextFollowUpDate', 'promisedAmountINR',
        'promisedDate', 'followUpMode', 'outcome', 'notes', 'loggedByUid',
        'loggedByName', 'loggedByRole', 'createdAt', 'updatedAt', 'dataOrigin'
      ]) &&
      data.id is string && data.id == followUpId && data.id.size() >= 1 && data.id.size() <= 128 &&
      isValidId(data.invoiceId) &&
      (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 128)) &&
      (!('customerId' in data) || (data.customerId is string && data.customerId.size() <= 128)) &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 160 &&
      data.contactPerson is string && data.contactPerson.size() >= 2 && data.contactPerson.size() <= 120 &&
      data.followUpDate is string && data.followUpDate.size() >= 4 && data.followUpDate.size() <= 40 &&
      data.nextFollowUpDate is string && data.nextFollowUpDate.size() >= 4 && data.nextFollowUpDate.size() <= 40 &&
      (!('promisedAmountINR' in data) || (data.promisedAmountINR is number && data.promisedAmountINR >= 0)) &&
      (!('promisedDate' in data) || (data.promisedDate is string && data.promisedDate.size() <= 40)) &&
      data.followUpMode is string && data.followUpMode in ['Phone Call', 'Email', 'WhatsApp', 'Executive Visit', 'Legal Notice'] &&
      data.outcome is string && data.outcome in ['Payment Promised', 'Part Payment Released', 'Dispute Raised', 'No Response', 'Cleared'] &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 600)) &&
      data.loggedByUid is string && data.loggedByUid.size() >= 1 && data.loggedByUid.size() <= 128 &&
      data.loggedByName is string && data.loggedByName.size() >= 2 && data.loggedByName.size() <= 160 &&
      isValidRoleValue(data.loggedByRole) &&
      data.createdAt is string && data.createdAt.size() >= 4 && data.createdAt.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      isValidDataOrigin(data);
    }

    // =========================================================================
    // 3. COLLECTION MATCH BLOCKS (ALL 27 COLLECTIONS)
    // =========================================================================

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        (isOwner(userId) && (resource == null || existing().accountStatus in ['active', 'pending_approval', 'pending_invitation', 'pending_setup', 'rejected'])) ||
        isSuperAdmin() ||
        isCeo()
      );
      allow list: if isActiveUser() && (isSuperAdmin() || isCeo()) && existing().uid is string;
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming(), userId) && (
        (
          isSuperAdmin() &&
          (!('approvedByUid' in incoming()) || incoming().approvedByUid == null || incoming().approvedByUid == request.auth.uid) &&
          (!('rejectedByUid' in incoming()) || incoming().rejectedByUid == null || incoming().rejectedByUid == request.auth.uid)
        ) ||
        (
          isCeo() &&
          !isOwner(userId) &&
          incoming().role != 'super_admin' &&
          incoming().role != 'ceo' &&
          (!('legacyRole' in incoming()) || (incoming().legacyRole != 'super_admin' && incoming().legacyRole != 'ceo')) &&
          (!('requestedRole' in incoming()) || (incoming().requestedRole != 'super_admin' && incoming().requestedRole != 'ceo')) &&
          (!('rbacGroup' in incoming()) || (incoming().rbacGroup != 'Admin' && incoming().rbacGroup != 'Management')) &&
          (!('approvedByUid' in incoming()) || incoming().approvedByUid == null || incoming().approvedByUid == request.auth.uid) &&
          (!('rejectedByUid' in incoming()) || incoming().rejectedByUid == null || incoming().rejectedByUid == request.auth.uid)
        ) ||
        (isOwner(userId) && isBootstrapOwner() && !userProfileExists()) ||
        (
          isOwner(userId) &&
          incoming().accountStatus == 'pending_approval' &&
          incoming().role != 'super_admin' &&
          incoming().role != 'ceo' &&
          (!('legacyRole' in incoming()) || (incoming().legacyRole != 'super_admin' && incoming().legacyRole != 'ceo')) &&
          (!('requestedRole' in incoming()) || (incoming().requestedRole != 'super_admin' && incoming().requestedRole != 'ceo')) &&
          (!('rbacGroup' in incoming()) || (incoming().rbacGroup != 'Admin' && incoming().rbacGroup != 'Management')) &&
          (!('isDepartmentHead' in incoming()) || incoming().isDepartmentHead == false) &&
          (!('approvedByUid' in incoming()) || incoming().approvedByUid == null) &&
          (!('approvedByEmail' in incoming()) || incoming().approvedByEmail == null) &&
          (!('approvedByName' in incoming()) || incoming().approvedByName == null) &&
          (!('approvedAt' in incoming()) || incoming().approvedAt == null) &&
          (!('rejectedByUid' in incoming()) || incoming().rejectedByUid == null) &&
          (!('rejectedAt' in incoming()) || incoming().rejectedAt == null)
        )
      );
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming(), userId) && (
        (
          isSuperAdmin() &&
          (!('approvedByUid' in incoming()) || incoming().approvedByUid == null || ('approvedByUid' in existing() && incoming().approvedByUid == existing().approvedByUid) || incoming().approvedByUid == request.auth.uid) &&
          (!('rejectedByUid' in incoming()) || incoming().rejectedByUid == null || ('rejectedByUid' in existing() && incoming().rejectedByUid == existing().rejectedByUid) || incoming().rejectedByUid == request.auth.uid)
        ) ||
        (
          isCeo() &&
          !isOwner(userId) &&
          existing().role != 'super_admin' &&
          existing().role != 'ceo' &&
          (!('legacyRole' in existing()) || (existing().legacyRole != 'super_admin' && existing().legacyRole != 'ceo')) &&
          (!('rbacGroup' in existing()) || (existing().rbacGroup != 'Admin' && existing().rbacGroup != 'Management')) &&
          incoming().role != 'super_admin' &&
          incoming().role != 'ceo' &&
          (!('legacyRole' in incoming()) || (incoming().legacyRole != 'super_admin' && incoming().legacyRole != 'ceo')) &&
          (!('requestedRole' in incoming()) || (incoming().requestedRole != 'super_admin' && incoming().requestedRole != 'ceo')) &&
          (!('rbacGroup' in incoming()) || (incoming().rbacGroup != 'Admin' && incoming().rbacGroup != 'Management')) &&
          (!('approvedByUid' in incoming()) || incoming().approvedByUid == null || ('approvedByUid' in existing() && incoming().approvedByUid == existing().approvedByUid) || incoming().approvedByUid == request.auth.uid) &&
          (!('rejectedByUid' in incoming()) || incoming().rejectedByUid == null || ('rejectedByUid' in existing() && incoming().rejectedByUid == existing().rejectedByUid) || incoming().rejectedByUid == request.auth.uid)
        ) ||
        (
          isOwner(userId) &&
          isActiveUser() &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().department == existing().department &&
          incoming().accountStatus == existing().accountStatus &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin', 'lastLoginAt', 'updatedAt', 'displayName', 'name', 'mustChangePassword'])
        ) ||
        (
          isOwner(userId) &&
          existing().accountStatus == 'pending_approval' &&
          incoming().accountStatus == 'pending_approval' &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().createdAt == existing().createdAt &&
          incoming().role != 'super_admin' &&
          incoming().role != 'ceo' &&
          (!('legacyRole' in incoming()) || (incoming().legacyRole != 'super_admin' && incoming().legacyRole != 'ceo')) &&
          (!('requestedRole' in incoming()) || (incoming().requestedRole != 'super_admin' && incoming().requestedRole != 'ceo')) &&
          (!('rbacGroup' in incoming()) || (incoming().rbacGroup != 'Admin' && incoming().rbacGroup != 'Management')) &&
          (!('isDepartmentHead' in incoming()) || incoming().isDepartmentHead == false) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'name', 'department', 'requestedDepartment', 'role', 'legacyRole', 'requestedRole', 'rbacGroup', 'designation', 'roleTitle', 'avatarInitials', 'approvalHistory', 'updatedAt'])
        )
      );
      allow delete: if isSignedIn() && isValidId(userId) && isSuperAdmin() && request.auth.uid != userId;
    }

    // Collection 2: /systemConfig/{configId}
    match /systemConfig/{configId} {
      allow get: if isActiveUser() && isValidId(configId);
      allow list: if isActiveUser() && existing().configId is string;
      allow create: if isActiveUser() && isValidId(configId) && isValidSystemConfig(incoming(), configId) && (
        isSuperAdmin() ||
        isCeo() ||
        (configId in ['dashboardKpis', 'productionSummary'] && !('monthlySalesTarget' in incoming()))
      );
      allow update: if isActiveUser() && isValidId(configId) && isValidSystemConfig(incoming(), configId) && (
        isSuperAdmin() ||
        isCeo() ||
        (
          configId in ['dashboardKpis', 'productionSummary'] &&
          incoming().configId == existing().configId &&
          incoming().configType == existing().configType &&
          // Only the CEO or Super Admin may set the monthly sales target.
          !incoming().diff(existing()).affectedKeys().hasAny(['monthlySalesTarget'])
        )
      );
      allow delete: if false;
    }

