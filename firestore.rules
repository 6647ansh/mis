rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. GLOBAL SAFETY NET — Default Deny Catch-All
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. CORE PRIMITIVES & IDENTITY HELPERS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapOwner() {
      return isVerifiedEmail() &&
        request.auth.token.email == 'anshyadav6647@gmail.com' &&
        (!userProfileExists() || currentUserDoc().accountStatus != 'deactivated');
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userProfileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Active account gate: user must have an authoritative profile document with accountStatus == 'active' (or be the verified bootstrap owner)
    function isActiveUser() {
      return isSignedIn() && (
        (userProfileExists() && currentUserDoc().accountStatus == 'active') ||
        isBootstrapOwner()
      );
    }

    // Granular 8-role resolution from authoritative /users/{uid} document
    function hasRole(targetRole) {
      return isSignedIn() && userProfileExists() && currentUserDoc().accountStatus == 'active' && (
        currentUserDoc().role == targetRole ||
        ('legacyRole' in currentUserDoc() && currentUserDoc().legacyRole == targetRole)
      );
    }

    function isSuperAdmin() {
      return hasRole('super_admin') || isBootstrapOwner();
    }

    function isCeo() {
      return hasRole('ceo');
    }

    function isSales() {
      return hasRole('sales');
    }

    function isStores() {
      return hasRole('stores');
    }

    function isPurchase() {
      return hasRole('purchase');
    }

    function isQuality() {
      return hasRole('quality');
    }

    function isDispatch() {
      return hasRole('dispatch');
    }

    function isFinance() {
      return hasRole('finance');
    }

    function isValidRoleValue(roleVal) {
      return roleVal is string && roleVal in [
        'super_admin',
        'ceo',
        'sales',
        'stores',
        'purchase',
        'quality',
        'dispatch',
        'finance'
      ];
    }

    function isValidDataOrigin(data) {
      return !('dataOrigin' in data) || (
        data.dataOrigin is string &&
        data.dataOrigin in ['production', 'demo_sandbox', 'bootstrap_seed']
      );
    }

    // =========================================================================
    // 2. ENTITY VALIDATION BLUEPRINTS (Anti-Update-Gap & Schema Enforcement)
    // =========================================================================

    // 2.1 UserProfile (/users/{userId})
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'role', 'department', 'accountStatus', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'uid', 'name', 'email', 'displayName', 'role', 'requestedRole', 'requestedDepartment',
        'legacyRole', 'rbacGroup', 'roleTitle', 'department', 'designation', 'avatarInitials', 'accountStatus', 'status',
        'mustChangePassword', 'invitedBy', 'provisionedBy', 'provisionedAt',
        'approvedByUid', 'approvedByEmail', 'approvedByName', 'approvedAt',
        'rejectedByUid', 'rejectedByEmail', 'rejectedByName', 'rejectedAt', 'rejectionReason', 'approvalHistory',
        'permissions', 'isDepartmentHead', 'managedDepartment', 'reportingManagerUid',
        'createdAt', 'updatedAt', 'lastLogin', 'lastLoginAt',
        'disabledAt', 'deactivatedBy', 'deactivationReason', 'dataOrigin'
      ]) &&
      data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      (!('id' in data) || (data.id is string && data.id == userId && data.id.size() >= 1 && data.id.size() <= 128)) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120 &&
      (!('name' in data) || (data.name is string && data.name.size() >= 2 && data.name.size() <= 120)) &&
      isValidRoleValue(data.role) &&
      (!('requestedRole' in data) || isValidRoleValue(data.requestedRole)) &&
      (!('requestedDepartment' in data) || (data.requestedDepartment is string && data.requestedDepartment.size() <= 80)) &&
      (!('legacyRole' in data) || (
        isValidRoleValue(data.legacyRole) &&
        (data.legacyRole != 'super_admin' || data.role == 'super_admin') &&
        (data.legacyRole != 'ceo' || data.role == 'ceo' || data.role == 'super_admin')
      )) &&
      (!('rbacGroup' in data) || (
        data.rbacGroup is string &&
        data.rbacGroup in ['Admin', 'Management', 'Sales', 'Production', 'Finance'] &&
        (data.rbacGroup != 'Admin' || data.role == 'super_admin') &&
        (data.rbacGroup != 'Management' || data.role == 'ceo' || data.role == 'super_admin')
      )) &&
      data.department is string && data.department.size() >= 2 && data.department.size() <= 80 &&
      (!('roleTitle' in data) || (data.roleTitle is string && data.roleTitle.size() >= 2 && data.roleTitle.size() <= 100)) &&
      (!('designation' in data) || (data.designation is string && data.designation.size() >= 2 && data.designation.size() <= 100)) &&
      (!('avatarInitials' in data) || (data.avatarInitials is string && data.avatarInitials.size() >= 1 && data.avatarInitials.size() <= 8)) &&
      data.accountStatus is string && data.accountStatus in [
        'active', 'deactivated', 'inactive', 'suspended', 'rejected', 'pending_invitation', 'pending_approval', 'pending_setup'
      ] &&
      (!('status' in data) || (data.status is string && data.status in ['Active', 'Inactive', 'Pending', 'Rejected'])) &&
      (!('mustChangePassword' in data) || data.mustChangePassword is bool) &&
      (!('isDepartmentHead' in data) || data.isDepartmentHead is bool) &&
      (!('managedDepartment' in data) || (data.managedDepartment is string && data.managedDepartment.size() <= 80)) &&
      (!('reportingManagerUid' in data) || (data.reportingManagerUid is string && data.reportingManagerUid.size() <= 128)) &&
      (!('invitedBy' in data) || (data.invitedBy is string && data.invitedBy.size() <= 160)) &&
      (!('provisionedBy' in data) || (data.provisionedBy is string && data.provisionedBy.size() <= 160)) &&
      (!('provisionedAt' in data) || (data.provisionedAt is string && data.provisionedAt.size() <= 40)) &&
      (!('approvedByUid' in data) || data.approvedByUid == null || (data.approvedByUid is string && data.approvedByUid.size() <= 128)) &&
      (!('approvedByEmail' in data) || data.approvedByEmail == null || (data.approvedByEmail is string && data.approvedByEmail.size() <= 160)) &&
      (!('approvedByName' in data) || data.approvedByName == null || (data.approvedByName is string && data.approvedByName.size() <= 160)) &&
      (!('approvedAt' in data) || data.approvedAt == null || (data.approvedAt is string && data.approvedAt.size() <= 40)) &&
      (!('rejectedByUid' in data) || data.rejectedByUid == null || (data.rejectedByUid is string && data.rejectedByUid.size() <= 128)) &&
      (!('rejectedByEmail' in data) || data.rejectedByEmail == null || (data.rejectedByEmail is string && data.rejectedByEmail.size() <= 160)) &&
      (!('rejectedByName' in data) || data.rejectedByName == null || (data.rejectedByName is string && data.rejectedByName.size() <= 160)) &&
      (!('rejectedAt' in data) || data.rejectedAt == null || (data.rejectedAt is string && data.rejectedAt.size() <= 40)) &&
      (!('rejectionReason' in data) || data.rejectionReason == null || (data.rejectionReason is string && data.rejectionReason.size() <= 500)) &&
      (!('approvalHistory' in data) || (data.approvalHistory is list && data.approvalHistory.size() <= 50)) &&
      (!('permissions' in data) || data.permissions is map || (data.permissions is list && data.permissions.size() <= 20)) &&
      data.createdAt is string && data.createdAt.size() >= 4 && data.createdAt.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      (!('lastLogin' in data) || (data.lastLogin is string && data.lastLogin.size() <= 40)) &&
      (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 40)) &&
      (!('disabledAt' in data) || data.disabledAt == null || (data.disabledAt is string && data.disabledAt.size() <= 40)) &&
      (!('deactivatedBy' in data) || data.deactivatedBy == null || (data.deactivatedBy is string && data.deactivatedBy.size() <= 160)) &&
      (!('deactivationReason' in data) || data.deactivationReason == null || (data.deactivationReason is string && data.deactivationReason.size() <= 300)) &&
      isValidDataOrigin(data);
    }

    // 2.2 SystemConfigDocument (/systemConfig/{configId})
    function isValidSystemConfig(data, configId) {
      return data.keys().hasAll(['configId', 'configType', 'updatedAt']) &&
      data.keys().hasOnly([
        'configId', 'configType', 'totalOrderBookValue', 'activeOrdersCount',
        'delayedOrdersCount', 'monthlyDispatchMT', 'monthlyDispatchTargetMT',
        'rawMaterialStockMT', 'lowStockAlertsCount', 'rejectionRatePct',
        'maxRejectionThresholdPct', 'totalOutstandingINR', 'overdueReceivablesINR',
        'fpyPercentage', 'reworkTons', 'scrapPct', 'ncrCount',
        'Low_Stock_Threshold_Tons', 'Delay_Threshold_Days', 'Rejection_Rate_Max_Pct',
        'Payment_Overdue_Days', 'monthlySalesTarget', 'updatedBy', 'updatedAt', 'dataOrigin'
      ]) &&
      data.configId is string && data.configId == configId &&
      data.configId in ['dashboardKpis', 'productionSummary', 'alertThresholds', 'connection_probe'] &&
      data.configType is string && data.configType == configId &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
      (!('totalOrderBookValue' in data) || (data.totalOrderBookValue is number && data.totalOrderBookValue >= 0)) &&
      (!('activeOrdersCount' in data) || (data.activeOrdersCount is number && data.activeOrdersCount >= 0)) &&
      (!('delayedOrdersCount' in data) || (data.delayedOrdersCount is number && data.delayedOrdersCount >= 0)) &&
      (!('monthlyDispatchMT' in data) || (data.monthlyDispatchMT is number && data.monthlyDispatchMT >= 0)) &&
      (!('rawMaterialStockMT' in data) || (data.rawMaterialStockMT is number && data.rawMaterialStockMT >= 0)) &&
      (!('Low_Stock_Threshold_Tons' in data) || (data.Low_Stock_Threshold_Tons is number && data.Low_Stock_Threshold_Tons >= 0)) &&
      (!('Delay_Threshold_Days' in data) || (data.Delay_Threshold_Days is number && data.Delay_Threshold_Days >= 0)) &&
      (!('Rejection_Rate_Max_Pct' in data) || (data.Rejection_Rate_Max_Pct is number && data.Rejection_Rate_Max_Pct >= 0 && data.Rejection_Rate_Max_Pct <= 100)) &&
      (!('Payment_Overdue_Days' in data) || (data.Payment_Overdue_Days is number && data.Payment_Overdue_Days >= 0)) &&
      (!('monthlySalesTarget' in data) || (configId == 'dashboardKpis' && data.monthlySalesTarget is number && data.monthlySalesTarget > 0)) &&
      isValidDataOrigin(data);
    }

    // 2.3 Customer (/customers/{customerId})
    function isValidCustomer(data, customerId) {
      return data.keys().hasAll([
        'id', 'name', 'contactPerson', 'email', 'creditLimit', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'code', 'name', 'contactPerson', 'email', 'phone', 'gstin', 'creditLimit',
        'paymentTermsDays', 'address', 'location', 'industry', 'assignedSalesPerson',
        'totalOrders', 'totalOutstanding', 'status', 'createdAt', 'updatedAt', 'dataOrigin'
      ]) &&
      data.id is string && data.id == customerId && data.id.size() >= 1 && data.id.size() <= 128 &&
      (!('code' in data) || (data.code is string && data.code.size() <= 64)) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
      data.contactPerson is string && data.contactPerson.size() >= 2 && data.contactPerson.size() <= 120 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
      (!('gstin' in data) || (data.gstin is string && data.gstin.size() <= 32)) &&
      data.creditLimit is number && data.creditLimit >= 0 &&
      (!('paymentTermsDays' in data) || (data.paymentTermsDays is number && data.paymentTermsDays >= 0)) &&
      (!('address' in data) || (data.address is string && data.address.size() <= 400)) &&
      (!('location' in data) || (data.location is string && data.location.size() <= 160)) &&
      (!('industry' in data) || (data.industry is string && data.industry.size() <= 120)) &&
      (!('assignedSalesPerson' in data) || (data.assignedSalesPerson is string && data.assignedSalesPerson.size() <= 120)) &&
      (!('totalOrders' in data) || (data.totalOrders is number && data.totalOrders >= 0)) &&
      (!('totalOutstanding' in data) || (data.totalOutstanding is number && data.totalOutstanding >= 0)) &&
      data.status is string && data.status in ['Active', 'On Hold', 'Inactive'] &&
      data.createdAt is string && data.createdAt.size() >= 4 && data.createdAt.size() <= 40 &&
      (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40)) &&
      isValidDataOrigin(data);
    }

    // 2.4 Product (/products/{productId})
    function isValidProduct(data, productId) {
      return data.keys().hasAll([
        'id', 'name', 'category', 'steelGrade', 'standardWeightKg', 'unitPrice', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'code', 'name', 'category', 'steelGrade', 'size', 'standard',
        'standardWeightKg', 'unitPrice', 'hsnCode', 'uom', 'drawingNo',
        'heatTreatmentReq', 'status', 'createdAt', 'updatedAt', 'dataOrigin'
      ]) &&
      data.id is string && data.id == productId && data.id.size() >= 1 && data.id.size() <= 128 &&
      (!('code' in data) || (data.code is string && data.code.size() <= 64)) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
      data.category is string && data.category in ['Flanges', 'Rolled Rings', 'Forged Shafts', 'Gear Blanks', 'Custom Forgings'] &&
      data.steelGrade is string && data.steelGrade.size() >= 2 && data.steelGrade.size() <= 64 &&
      (!('size' in data) || (data.size is string && data.size.size() <= 120)) &&
      (!('standard' in data) || (data.standard is string && data.standard.size() <= 120)) &&
      data.standardWeightKg is number && data.standardWeightKg > 0 &&
      data.unitPrice is number && data.unitPrice >= 0 &&
      (!('hsnCode' in data) || (data.hsnCode is string && data.hsnCode.size() <= 32)) &&
      (!('uom' in data) || (data.uom is string && data.uom.size() <= 24)) &&
      (!('drawingNo' in data) || (data.drawingNo is string && data.drawingNo.size() <= 80)) &&
      (!('heatTreatmentReq' in data) || (data.heatTreatmentReq is string && data.heatTreatmentReq.size() <= 120)) &&
      data.status is string && data.status in ['Active', 'Discontinued'] &&
      data.createdAt is string && data.createdAt.size() >= 4 && data.createdAt.size() <= 40 &&
      (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40)) &&
      isValidDataOrigin(data);
    }

    // 2.5 OrderJourney (/salesOrders/{orderId})
    function isValidSalesOrder(data, orderId) {
      return data.keys().hasAll([
        'orderId', 'customerName', 'productName', 'steelGrade', 'quantityMT',
        'totalValueINR', 'orderDate', 'committedDeliveryDate', 'currentStage',
        'overallStatus', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'orderId', 'customerId', 'customerName', 'productId', 'productName',
        'steelGrade', 'quantityMT', 'totalValueINR', 'orderDate', 'committedDeliveryDate',
        'currentStage', 'overallStatus', 'delayDays', 'delayReason', 'heatNo',
        'mtcStatus', 'dispatchStatus', 'invoiceNo', 'paymentStatus', 'stages',
        'fprUid', 'fprName', 'fprDepartment', 'handoverStage', 'documentChecklistStatus',
        'creditHoldOverrideBy', 'creditHoldOverrideReason',
        'createdBy', 'createdAt', 'updatedAt', 'dataOrigin'
      ]) &&
      data.orderId is string && data.orderId == orderId && data.orderId.size() >= 1 && data.orderId.size() <= 128 &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 160 &&
      data.productName is string && data.productName.size() >= 2 && data.productName.size() <= 160 &&
      data.steelGrade is string && data.steelGrade.size() >= 1 && data.steelGrade.size() <= 64 &&
      data.quantityMT is number && data.quantityMT > 0 &&
      data.totalValueINR is number && data.totalValueINR >= 0 &&
      data.orderDate is string && data.orderDate.size() >= 4 && data.orderDate.size() <= 40 &&
      data.committedDeliveryDate is string && data.committedDeliveryDate.size() >= 4 && data.committedDeliveryDate.size() <= 40 &&
      data.currentStage is string && data.currentStage in [
        'Inquiry', 'Order Confirmed', 'Raw Material Allocated', 'Forging',
        'Heat Treatment', 'Machining', 'Quality Inspection', 'Ready for Dispatch',
        'Dispatched', 'Invoiced'
      ] &&
      data.overallStatus is string && data.overallStatus in [
        'On Track', 'At Risk', 'Delayed', 'Completed', 'Cancelled'
      ] &&
      (!('delayDays' in data) || (data.delayDays is number && data.delayDays >= 0)) &&
      (!('delayReason' in data) || (data.delayReason is string && data.delayReason.size() <= 400)) &&
      (!('heatNo' in data) || (data.heatNo is string && data.heatNo.size() <= 64)) &&
      (!('mtcStatus' in data) || (data.mtcStatus is string && data.mtcStatus in ['Pending', 'Generated', 'Verified'])) &&
      (!('dispatchStatus' in data) || (data.dispatchStatus is string && data.dispatchStatus in ['Not Started', 'Partial', 'Dispatched', 'Delivered'])) &&
      (!('invoiceNo' in data) || (data.invoiceNo is string && data.invoiceNo.size() <= 64)) &&
      (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus in ['Unbilled', 'Pending', 'Partially Paid', 'Paid', 'Overdue'])) &&
      (!('stages' in data) || (data.stages is list && data.stages.size() <= 12 && (data.stages.size() == 0 || data.stages[0] is map))) &&
      (!('fprUid' in data) || (data.fprUid is string && data.fprUid.size() <= 128)) &&
      (!('fprName' in data) || (data.fprName is string && data.fprName.size() <= 120)) &&
      (!('fprDepartment' in data) || (data.fprDepartment is string && data.fprDepartment.size() <= 80)) &&
      (!('handoverStage' in data) || (data.handoverStage is string && data.handoverStage in ['H-1', 'H-2', 'H-3', 'H-4', 'H-5'])) &&
      (!('documentChecklistStatus' in data) || (data.documentChecklistStatus is string && data.documentChecklistStatus in ['Incomplete', 'Ready', 'Verified'])) &&
      (!('creditHoldOverrideBy' in data) || (data.creditHoldOverrideBy is string && data.creditHoldOverrideBy.size() <= 120)) &&
      (!('creditHoldOverrideReason' in data) || (data.creditHoldOverrideReason is string && data.creditHoldOverrideReason.size() <= 400)) &&
      (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128)) &&
      data.createdAt is string && data.createdAt.size() >= 4 && data.createdAt.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      isValidDataOrigin(data);
    }

    // 2.6 DispatchConsignmentRecord (/dispatches/{dispatchId})
    function isValidDispatch(data, dispatchId) {
      return data.keys().hasAll([
        'id', 'orderId', 'customerName', 'quantityTons', 'dispatchDate', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'orderId', 'customerName', 'productName', 'quantityTons', 'dispatchDate',
        'transporterName', 'vehicleNo', 'lrNo', 'invoiceNo', 'destination', 'status',
        'createdBy', 'createdAt', 'updatedAt', 'dataOrigin'
      ]) &&
      data.id is string && data.id == dispatchId && data.id.size() >= 1 && data.id.size() <= 128 &&
      isValidId(data.orderId) &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 160 &&
      (!('productName' in data) || (data.productName is string && data.productName.size() <= 160)) &&
      data.quantityTons is number && data.quantityTons > 0 &&
      data.dispatchDate is string && data.dispatchDate.size() >= 4 && data.dispatchDate.size() <= 40 &&
      (!('transporterName' in data) || (data.transporterName is string && data.transporterName.size() <= 120)) &&
      (!('vehicleNo' in data) || (data.vehicleNo is string && data.vehicleNo.size() <= 40)) &&
      (!('lrNo' in data) || (data.lrNo is string && data.lrNo.size() <= 64)) &&
      (!('invoiceNo' in data) || (data.invoiceNo is string && data.invoiceNo.size() <= 64)) &&
      (!('destination' in data) || (data.destination is string && data.destination.size() <= 160)) &&
      data.status is string && data.status in ['Scheduled', 'Loading', 'In Transit', 'Delivered', 'Delayed'] &&
      (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128)) &&
      data.createdAt is string && data.createdAt.size() >= 4 && data.createdAt.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 4 && data.updatedAt.size() <= 40 &&
      isValidDataOrigin(data);
    }

    // 2.7 RawMaterialStock (/rawMaterials/{materialId})
    function isValidRawMaterial(data, materialId) {
      return data.keys().hasAll([
        'gradeId', 'steelGrade', 'availableMT', 'reorderLevelMT', 'status', 'lastUpdated'
      ]) &&
      data.keys().hasOnly([
        'gradeId', 'steelGrade', 'category', 'availableMT', 'allocatedMT',
        'reorderLevelMT', 'unitCostPerMT', 'supplierName', 'heatBatchNo',
        'locationYard', 'status', 'lastUpdated', 'updatedBy', 'dataOrigin'
      ]) &&
      data.gradeId is string && data.gradeId == materialId && data.gradeId.size() >= 1 && data.gradeId.size() <= 128 &&
      data.steelGrade is string && data.steelGrade.size() >= 1 && data.steelGrade.size() <= 64 &&
      (!('category' in data) || (data.category is string && data.category in ['Carbon Steel', 'Alloy Steel', 'Stainless Steel', 'Tool Steel', 'Duplex Steel'])) &&
      data.availableMT is number && data.availableMT >= 0 &&
      (!('allocatedMT' in data) || (data.allocatedMT is number && data.allocatedMT >= 0)) &&
      data.reorderLevelMT is number && data.reorderLevelMT >= 0 &&
      (!('unitCostPerMT' in data) || (data.unitCostPerMT is number && data.unitCostPerMT >= 0)) &&
      (!('supplierName' in data) || (data.supplierName is string && data.supplierName.size() <= 160)) &&
      (!('heatBatchNo' in data) || (data.heatBatchNo is string && data.heatBatchNo.size() <= 64)) &&
      (!('locationYard' in data) || (data.locationYard is string && data.locationYard.size() <= 80)) &&
      data.status is string && data.status in ['Healthy', 'Low Stock', 'Critical'] &&
      data.lastUpdated is string && data.lastUpdated.size() >= 4 && data.lastUpdated.size() <= 40 &&
      (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
      isValidDataOrigin(data);
    }

    // 2.8 StockMovement (/stockMovements/{movementId})
    function isValidStockMovement(data, movementId) {
      return data.keys().hasAll([
        'id', 'gradeId', 'steelGrade', 'type', 'quantityTons', 'performedBy', 'timestamp'
      ]) &&
      data.keys().hasOnly([
        'id', 'gradeId', 'steelGrade', 'type', 'quantityTons', 'heatNumber',
        'referenceDocument', 'orderId', 'performedBy', 'performedByUid',
        'timestamp', 'remarks', 'balanceAfterMT', 'dataOrigin'
      ]) &&
      data.id is string && data.id == movementId && data.id.size() >= 1 && data.id.size() <= 128 &&
      isValidId(data.gradeId) &&
      data.steelGrade is string && data.steelGrade.size() >= 1 && data.steelGrade.size() <= 64 &&
      data.type is string && data.type in ['INWARD', 'ISSUE', 'RETURN', 'ADJUSTMENT'] &&
      data.quantityTons is number && data.quantityTons > 0 &&
      (!('heatNumber' in data) || (data.heatNumber is string && data.heatNumber.size() <= 64)) &&
      (!('referenceDocument' in data) || (data.referenceDocument is string && data.referenceDocument.size() <= 120)) &&
      (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 128)) &&
      data.performedBy is string && data.performedBy.size() >= 2 && data.performedBy.size() <= 160 &&
