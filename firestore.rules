    // Collection 23: /tasks/{taskId} (Central Task, Duty & Supervisor Verification Engine)
    match /tasks/{taskId} {
      allow get: if isActiveUser() && isValidId(taskId);
      allow list: if isActiveUser() && existing().id is string;
      allow create: if isActiveUser() && isValidId(taskId) && isValidTaskRecord(incoming(), taskId);
      allow update: if isActiveUser() && isValidId(taskId) && isValidTaskRecord(incoming(), taskId) &&
        incoming().id == existing().id && incoming().createdAt == existing().createdAt && (
        isSuperAdmin() ||
        isCeo() ||
        // Maker != Checker: Non-executive employee cannot mark their own assigned task 'Verified & Approved'
        (incoming().status != 'Verified & Approved') ||
        (incoming().assignedToUid != request.auth.uid && ('isDepartmentHead' in currentUserDoc() && currentUserDoc().isDepartmentHead == true))
