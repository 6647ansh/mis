# ============================================================================
# MONTEX FORGE MIS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# SECURITY RULE:
# - Never commit actual API secrets, private keys, tokens, or service-account JSON.
# - Any variable prefixed with VITE_ is bundled into the public browser client.
#   NEVER place server-side secrets or admin credentials in VITE_* variables.

# ----------------------------------------------------------------------------
# 1. AI STUDIO & RUNTIME HOSTING (Server-Side / Runtime Injected)
# ----------------------------------------------------------------------------
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY_PLACEHOLDER"
APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# 2. CURRENT CLIENT-SIDE FIREBASE CONFIGURATION (Vite SPA — Phase 1 Active)
# ----------------------------------------------------------------------------
# Loaded by `src/lib/firebase.ts` with fallback to `firebase-applet-config.json`.
# Optional: firebase-applet-config.json already holds these. Uncomment only to override.
VITE_FIREBASE_PROJECT_ID="montexforge-7d537"
# VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY_PLACEHOLDER"
VITE_FIREBASE_AUTH_DOMAIN="montexforge-7d537.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://montexforge-7d537-default-rtdb.firebaseio.com/"
VITE_FIREBASE_STORAGE_BUCKET="montexforge-7d537.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID_PLACEHOLDER"
# VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID_PLACEHOLDER"

# ----------------------------------------------------------------------------
# 3. CLOUD FIRESTORE & PHASE 3 TRUSTED BACKEND CONFIGURATION (`server.ts`)
# ----------------------------------------------------------------------------
# [Cloud Firestore Named Database ID]
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# [Trusted Express Backend (`server.ts`) & Firebase Admin SDK — Server-Only]
# IMPORTANT: Never prefix server-only credentials with VITE_
PORT="3000"
FIREBASE_PROJECT_ID="montexforge-7d537"
FIREBASE_FIRESTORE_DATABASE_ID="(default)"
FIREBASE_DATABASE_URL="https://montexforge-7d537-default-rtdb.firebaseio.com/"
ALLOWED_CORS_ORIGINS="http://localhost:3000"
# Provide ONE of the following in production for Firebase Admin SDK:
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/mounted-service-account-key.json"
# FIREBASE_SERVICE_ACCOUNT_JSON=""
